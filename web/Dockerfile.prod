# Production image for the web frontend.
#
# Stage 1 — build the static bundle with Vite.
# Stage 2 — serve `dist/` with nginx:alpine, using a small SPA-aware config.
#
# Built by docker-compose.prod.yml. The build context is the repository root
# so this file can copy both `web/` (sources) and `deploy/nginx-web.conf`.

# ---- build stage ----
# Digest pinned on 2026-09-02; bump via Dependabot (docker ecosystem).
FROM node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS build

WORKDIR /app

# Install deps with a reproducible lockfile resolution.
COPY web/package.json web/package-lock.json* ./
RUN npm ci

# Copy sources and produce dist/.
COPY web/ ./

# The in-app manual and the About page's "Latest changes" are bundled at
# build time by `scripts/copy-docs.mjs` (a prebuild step, same shape as
# copy-zxing-wasm.mjs). That script resolves its sources relative to the
# repo root — which, with WORKDIR=/app holding `web/`, is `/` inside this
# image. So the end-user doc shelf and CHANGELOG.md have to land at those
# exact paths. Root-level `*.md` is excluded by .dockerignore, hence the
# explicit `!CHANGELOG.md` negation there.
#
# Placed after `npm ci` so a docs-only edit doesn't invalidate the
# dependency layer.
COPY docs/user/ /docs/user/
COPY CHANGELOG.md /CHANGELOG.md

# Sentry DSN baked into the bundle at build time. Empty when unset → SDK
# init no-ops, no events, no network egress. The DSN is intentionally
# public (Sentry's threat model treats it as an identifier, not a key).
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
ARG VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
ARG VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.0
# Release identifier (git SHA) — used as Sentry's `release` tag so Sentry
# groups issues per release.
ARG VITE_APP_VERSION=
# ISO-8601 UTC build timestamp, shown on /about beside the two build SHAs.
# Empty is fine — the page just omits the "built at" line.
ARG VITE_BUILD_TIME=
# Umami (self-hosted analytics) — both must be set for the loader IIFE
# in web/index.html to inject the tracker. Empty values disable tracking
# entirely (no network call, no DOM mutation).
ARG VITE_UMAMI_WEBSITE_ID=
ARG VITE_UMAMI_SCRIPT_URL=

ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE
ENV VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=$VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE
ENV VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=$VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_BUILD_TIME=$VITE_BUILD_TIME
ENV VITE_UMAMI_WEBSITE_ID=$VITE_UMAMI_WEBSITE_ID
ENV VITE_UMAMI_SCRIPT_URL=$VITE_UMAMI_SCRIPT_URL
# SENTRY_AUTH_TOKEN / _ORG / _PROJECT are NOT passed here — source-map
# upload is handled by the CI web-build job so the token never enters the
# Docker layer cache (INFRA2-010).

RUN test -n "$VITE_SENTRY_TRACES_SAMPLE_RATE" \
  && npm run build


# ---- runtime stage ----
# Digest pinned on 2026-09-02; bump via Dependabot (docker ecosystem).
FROM nginx:alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913 AS runtime

# Replace the default site with our SPA-aware config (try_files → index.html).
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf

# Static bundle. Strip sourcemaps from the served image — they're
# uploaded to Sentry by the CI web-build job (INFRA2-010), and
# Vite's `sourcemap: "hidden"` only suppresses the //# sourceMappingURL
# comment at the bottom of the JS, not the .map files themselves.
# Leaving them under /assets/*.map exposes the original source to anyone
# who can guess the bundle hash (Infra CRIT-5).
COPY --from=build /app/dist /usr/share/nginx/html
RUN find /usr/share/nginx/html -name '*.map' -delete

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
