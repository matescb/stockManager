# Production image for the web frontend.
#
# Stage 1 — build the static bundle with Vite.
# Stage 2 — serve `dist/` with nginx:alpine, using a small SPA-aware config.
#
# Built by docker-compose.prod.yml. The build context is the repository root
# so this file can copy both `web/` (sources) and `deploy/nginx-web.conf`.

# ---- build stage ----
FROM node:20-alpine AS build

WORKDIR /app

# Install deps with a reproducible lockfile resolution.
COPY web/package.json web/package-lock.json* ./
RUN npm ci

# Copy sources and produce dist/.
COPY web/ ./
RUN npm run build


# ---- runtime stage ----
FROM nginx:alpine AS runtime

# Replace the default site with our SPA-aware config (try_files → index.html).
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf

# Static bundle.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
