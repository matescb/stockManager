# Production image for the web frontend.
#
# Stage 1 — build the static bundle with Vite.
# Stage 2 — serve `dist/` with nginx:alpine, using a small SPA-aware config.
#
# Built by docker-compose.prod.yml. The build context is the repository root
# so this file can copy both `web/` (sources) and `deploy/nginx-web.conf`.

# ---- build stage ----
FROM node:20-alpine AS build

WORKDIR /app

# Install deps with a reproducible lockfile resolution.
COPY web/package.json web/package-lock.json* ./
RUN npm ci

# Copy sources and produce dist/.
COPY web/ ./

# Sentry DSN baked into the bundle at build time. Empty when unset → SDK
# init no-ops, no events, no network egress. The DSN is intentionally
# public (Sentry's threat model treats it as an identifier, not a key).
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0.0
# Release identifier (git SHA) — used as Sentry's `release` tag and as the
# anchor that source-map upload pins maps to.
ARG VITE_APP_VERSION=
# Source-map upload credentials. Only the build-stage uses these; they're
# never present in the runtime image. Empty → upload is skipped.
ARG SENTRY_AUTH_TOKEN=
ARG SENTRY_ORG=
ARG SENTRY_PROJECT=

ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN
ENV SENTRY_ORG=$SENTRY_ORG
ENV SENTRY_PROJECT=$SENTRY_PROJECT

RUN npm run build


# ---- runtime stage ----
FROM nginx:alpine AS runtime

# Replace the default site with our SPA-aware config (try_files → index.html).
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf

# Static bundle. Strip sourcemaps from the served image — they're
# already uploaded to Sentry by sentryVitePlugin during the build, and
# Vite's `sourcemap: "hidden"` only suppresses the //# sourceMappingURL
# comment at the bottom of the JS, not the .map files themselves.
# Leaving them under /assets/*.map exposes the original source to anyone
# who can guess the bundle hash (Infra CRIT-5).
COPY --from=build /app/dist /usr/share/nginx/html
RUN find /usr/share/nginx/html -name '*.map' -delete

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
