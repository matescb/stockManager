# Production environment template.
#
# Copy this file to `.env.prod` at the repo root and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Do NOT commit `.env.prod`. It is intentionally not gitignored here only
# because the file does not yet exist — the template (this file) is safe.

# ---- Postgres ----
# Username for the application database role.
POSTGRES_USER=stockmgr

# Database name. The backend connects to this DB via the `db` service.
POSTGRES_DB=stockmgr

# Strong password for the Postgres role above. Replace before first boot —
# the placeholder below is NOT a secret. Generate one with:
#   openssl rand -base64 24
POSTGRES_PASSWORD=replace-me-with-a-strong-random-password

# ---- Backend ----
# Secret used to sign / mint session tokens. Anyone with this value can forge
# logins, so keep it out of source control and rotate it on suspicion.
#
# REQUIRED: rotate this!
# Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-me-with-the-output-of-openssl-rand-hex-32

# Comma-separated list of origins allowed to call the API from a browser.
# In a typical single-domain prod deploy this is just your public hostname.
# Example: https://parts.example.com
CORS_ORIGINS=https://your-domain.example
