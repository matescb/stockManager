# TypeScript build info
*.tsbuildinfo

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg
.venv/
venv/

# Node
node_modules
dist/
.vite/

# Generated by web/scripts/copy-zxing-wasm.mjs as a prebuild step.
web/public/zxing/

# Generated by web/scripts/copy-docs.mjs as a predev/prebuild/pretest step.
# Build output — the source of truth is docs/user/ and CHANGELOG.md.
web/src/generated/

# tsc -b project-reference build emits a transpiled vite.config.js next
# to the .ts source — never used at runtime (Vite reads .ts directly).
web/vite.config.js

# Local env
.env
.env.prod
!.env.example
!deploy/.env.prod.example

# TLS material for the production proxy (see docs/deployment.md)
deploy/certs/

# Local uploads (mounted volume)
uploads/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Local test DBs / scratch
*.sqlite
*.sqlite3
.coverage
htmlcov/
coverage.xml
web/coverage/

# Claude Code local artifacts (transcript exports, scratch logs).
/2*-this-session-*.txt

.venv_review/

# Untracked review run artifacts (out-of-band analyses).
/review-*/

# tsc emits a .d.ts next to vite.config.ts under composite project refs.
web/vite.config.d.ts

# Playwright artifacts (TEST-004 / E2E suite).
web/playwright-report/
web/test-results/
web/.playwright/


# Agent-harness scratch worktrees. CLAUDE.md notes that transient
# review-*/ dirs and stray venvs appear at the repo root during agent
# sessions and are gitignored; this one was not, and showed up as
# untracked noise in every `git status`.
.claude/worktrees/
